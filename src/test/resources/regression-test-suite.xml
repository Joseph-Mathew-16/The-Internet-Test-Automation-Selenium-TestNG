<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Regression suite: runs every test class in the testcases package. Tests run in parallel. -->
<suite name="The Internet Application - Automated Test Suite"
    parallel="true">
    <listeners>
        <!-- Adds the retry analyzer to every test. -->
        <listener class-name="utilities.AnnotationTransformer" />
        <!-- Creates and verifies soft assertions around each test method. -->
        <listener class-name="utilities.SoftAssertListener" />
        <!-- Writes the Allure results. -->
        <listener class-name="io.qameta.allure.testng.AllureTestNg" />
    </listeners>
    <test name="Automation Test">
        <packages>
            <package name="testcases" />
        </packages>
    </test>
</suite>
